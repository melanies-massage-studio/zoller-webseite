    "before": "default",
    "after": "default"
   }
  },
  {
   "type": "cols",
   "layout": "33-66",
   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h2> Tool Management Software That's Right for You </h2>",
      "body": "<p>ZOLLER's modular TMS Tool Management Solutions software offers all the functions and interfaces you would expect from modern tool management software.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "textmedia",
      "id": "c8119",
      "bg": "",
