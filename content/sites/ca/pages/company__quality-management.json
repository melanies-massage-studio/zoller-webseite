       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p>The name ZOLLER is synonymous with quality and precision worldwide. And for good reason. We use exclusively high-quality materials and brand-name components—the best prerequisites for exact results. And with ZOLLER’s sophisticated software, this precision is achieved in every production environment regardless of the user—thanks to simple machine control and a high degree of automation.</p> <p>All of this ensures that the processes in your production run smoothly. It ensures that you deliver top quality—including complete documentation—to your customers on time.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c3275",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ]
   ],
   "ftype": "container-2cols",
   "id": "c3273",
   "bg": "",
