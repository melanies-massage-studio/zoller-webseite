     "label": "Module 4 Customized training content tailored to your requirements",
     "img": null,
     "text": "<h4><strong>Customized</strong><br/><strong>Training Content</strong></h4> <p>Network Integration</p> <p>Measuring Machine Refresher Training</p> <p>Output Format Adjustment</p> <p>Tool identification</p>"
    }
