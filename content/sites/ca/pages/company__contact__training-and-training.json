     },
     "label": "Module 3 Training on TMS Tool Management Solutions Software",
     "img": null,
     "text": "<h4><br/><strong>Software Training</strong></h4> <p>Teaching Software Functions</p> <p>Addressing specific employee questions</p> <p>Duration depends on the selected software packages</p>"
    },
