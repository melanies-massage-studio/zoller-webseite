     },
     "label": "Module 1 Commissioning / Basic Training on Measuring Machines",
     "img": null,
     "text": "<h4><strong>Basic Training on</strong><br/><strong>Measuring Machines</strong></h4> <p>Installation and Commissioning of the Measuring Machine</p> <p>Introduction to Basic Functions</p> <p>Simple software training for measuring and adjusting tools</p>"
    },
    {
     "logo": {
      "src": "/fileadmin/_processed_/c/5/csm_training_02_8b4cd3f636.webp",
      "alt": "",
      "w": 680,
      "h": 490
     },
     "label": "Module 2 Installation / Basic Training: Inspection and Measuring Program",
     "img": null,
     "text": "<h4><strong>Basic Training in</strong><br/><strong>Testing and Measurement Programs</strong></h4> <p>Professional installation of the required program</p> <p>Instruction on the program’s basic functions</p> <p>Customized attention to user requirements</p>"
    },
