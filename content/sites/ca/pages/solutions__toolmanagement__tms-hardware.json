    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">Do you want to work more productively and cost-effectively with an efficient tool storage system? Then ZOLLER Smart Cabinets are just right for you!</p> <p class=\"large-text\">We offer the right storage solution, whether you want to manage tools and their components, accessories, or inspection tools. Thanks to software integration, the entire storage system can be represented virtually.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c163266",
