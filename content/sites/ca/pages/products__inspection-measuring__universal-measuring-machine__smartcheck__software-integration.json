  {
   "type": "textmedia",
   "header": "<h2> Groundbreaking Efficiency for Your Grinding Shop </h2>",
   "body": "<p class=\"large-text\">The greatest potential for efficiency lies outside the grinding machine: ZOLLER Solutions are your key to the future—we help you achieve greater success. After all, those who manufacture faster and more efficiently operate more cost-effectively, enabling them to invest in the future. If economic progress is your goal, then ZOLLER is your partner.</p>",
   "images": [],
   "videos": [],
   "pos": "text",
   "cols": 1,
   "valign": "center",
   "ftype": "textmedia",
   "id": "c1936",
