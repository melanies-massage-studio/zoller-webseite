    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">At the ZOLLER Smart Factory, you’ll see the ZOLLER system and its seven solutions in action. You’ll gain insight into how you can unlock additional efficiency potential in your manufacturing through the seamless integration of hardware, software, interfaces, and automation.</p> <p class=\"large-text\">The ZOLLER Smart Factory impressively demonstrates that the path to greater productivity can be achieved in small steps. This makes it easier to plan and implement improvements to your own manufacturing processes. </p> <p class=\"large-text\">Schedule your visit to the ZOLLER Smart Factory in Pleidelsheim today. </p> <p class=\"large-text\"><a class=\"btn\" href=\"/ca/company/contact\">Schedule an appointment now</a></p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c2843",
      "bg": "",
