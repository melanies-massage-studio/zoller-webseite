   "images": [
    {
     "src": "/fileadmin/_processed_/4/0/csm_roboBox_info_Ein-Ausgabemodul_7e6416b756.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "State-of-the-art input/output module",
     "caption": "<figcaption> <h3>State-of-the-art input/output module</h3> <p>Input/Output Module for the »smartPallet System« – serves for securely holding your tool pallets. The tool pallets can be delivered either using the manual pallet jack or the »»coraExpress«« cobot transport system.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/e/7/csm_roboBox_info_Roboterbasismodul_3a24db0e88.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "Intelligent Robot Base Module",
     "caption": "<figcaption> <h3>Intelligent Robot Base Module</h3> <p>Robot Base Module – in which the FANUC 6-axis articulated-arm robot picks up the tools and reliably transports them between the various modules.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/1/a/csm_roboBox_info_Montagemodule_c2aef185f8.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "Innovative Assembly Modules",
     "caption": "<figcaption> <h3>Innovative Assembly Modules</h3> <p>Mounting Modules – for tool processing. Using the variable mounting modules, tools can be, for example, shrink-fitted and unshrink-fitted, cooled, measured, clamped and unclamped vertically, and pressed in and out within the »»roboBox««.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/f/1/csm_roboBox_info_Messmodul_0876459bc5.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "High-Precision Measurement Module",
     "caption": "<figcaption> <h3>High-Precision Measurement Module</h3> <p>Measuring module—into which the measurement tool is used. The measuring process starts automatically. </p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/7/7/csm_roboBox_info_Steuerungssoftware_43a2601b27.webp",
     "alt": "",
     "w": 616,
     "h": 334,
     "title": "Server-based control software",
     "caption": "<figcaption> <h3>Server-based control software</h3> <p>Control software – for the operation of the automation system. The control software can be displayed on different display devices (monitor, tablet, or smartphone). </p> </figcaption>"
    }
   ],
