   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h2 class=\"headline-decor\"> Start with a Solution – Enter a System. </h2>",
      "body": "<p class=\"extra-large-text\">The surest way to remain capable of operating in the long term lies in opting for a holistic system.</p> <p class=\"extra-large-text\">ZOLLER is the only manufacturer worldwide that can offer you such a system. It focuses on cutting tools and uses data to integrate the associated processes. The result: maximum efficiency, quality, and precision for your machining operations.</p> <p class=\"extra-large-text\">You start where you are. You stop when your requirements are met. And you always have the safety that you can take the next step. </p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c556",
      "bg": "yellow",
      "space": {
       "before": "default",
       "after": "default"
      }
