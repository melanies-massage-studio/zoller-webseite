     "video": "/fileadmin/01_Pages/The_System/ZOLLER_WELT_1920x1080.mp4",
     "title": "ZOLLER – the only one with a system",
     "kicker": "",
     "text": "<p>Our customers benefit from<br/>comprehensive solutions<br/>that we have been developing for decades.<br/>The result: outstanding efficiency. </p>",
     "buttons": [],
