   "images": [
    {
     "src": "/fileadmin/_processed_/2/d/csm_tribos_spanneinheit_14a487af18.webp",
     "alt": "",
     "w": 955,
     "h": 537,
     "title": "Fully automated with »»tribos««",
     "caption": "<figcaption> <h3>Fully automated with »»tribos««</h3> <p>The SCHUNK-TRIBOS clamping unit moves automatically to the clamping position and returns to its starting position once the clamping/unclamping process ends.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/4/8/csm_tribos_pilot_11cbe8523d.webp",
     "alt": "",
     "w": 955,
     "h": 537,
     "title": "Securely supported by »pilot«",
     "caption": "<figcaption> <h3>Securely supported by »pilot«</h3> <p>The optimal interaction between the »»pilot«« image processing technology and the control system for Schunk's TRIBOS clamping unit ensures that the tool length is adjusted with μm-accurate precision.</p> </figcaption>"
    }
