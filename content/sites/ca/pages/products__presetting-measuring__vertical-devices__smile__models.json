       "before": "default",
       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">The ZOLLER »smile« entry-level models are equipped with high-quality brand-name components and are available with three software options: »pilotBasic«, »pilotStarter«, and »pilot 2 mT«. You’ll get precise results right away—without the need for training. Ideal for all standard tools and designed to meet the tooling needs of small and medium-sized batch sizes. Robust, space-saving, and flexible—it can be placed right next to the CNC machine, on the shop floor, or in production cells.</p> <p class=\"large-text\">In short—the »smileCompact« is the perfect introduction to the world of ZOLLER.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c3494",
