     "video": "/fileadmin/01_Pages/Startingpage/zollerinfo_header_animation_780.mp4",
     "title": "A Systematic Approach to Achieving the Maximum",
     "kicker": "",
     "text": "<p>Boost the efficiency of your tooling processes<br/>with solutions from the technology leader: ZOLLER.</p>",
     "buttons": [],
     "light": false
    }
   ],
   "ftype": "zoller_hero-slider",
