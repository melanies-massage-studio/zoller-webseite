     "src": "/fileadmin/_processed_/d/6/csm_reamcheck_duo_188a50fd30.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "\"duo\" Electronic Measuring Sensor",
     "caption": "<figcaption> <h3>\"duo\" Electronic Measuring Sensor</h3> <p>For simultaneously presetting and measuring the diameters and tapers of, for example, reamers using the oversize principle. The sensors are magnetic and can be attached as needed.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/5/f/csm_reamcheck_cnc_steuerung_c04de8e0a9.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "Automatic with CN control",
     "caption": "<figcaption> <h3>Automatic with CN control</h3> <p>Fast, CNC-controlled axial runout or<br/> concentricity test on cutter heads or CAP milling cutters.</p> </figcaption>"
    },
    {
     "src": "/fileadmin/_processed_/f/8/csm_reamcheck_messprogramme_6fff996f91.webp",
     "alt": "",
     "w": 633,
     "h": 356,
     "title": "Measurement Program Selection",
     "caption": "<figcaption> <h3>Measurement Program Selection</h3> <p>Extensive selection of measurement programs in »pilot« with a photorealistic input dialog for simple operation and accurate specification of target dimensions to ensure safety.</p> </figcaption>"
    }
