    [
     {
      "type": "textmedia",
      "header": "<h2> Notre lieu pour votre expérience </h2>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
