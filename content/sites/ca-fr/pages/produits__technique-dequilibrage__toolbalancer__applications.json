        ]
       },
       {
        "title": "Aide visuelle au vissage",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Affichage graphique de la position angulaire de la broche sur l'écran.</p>",
          "images": [
           {
            "src": "/fileadmin/_processed_/1/2/csm_Optische_Eindrehhilfe_DE_74944f939a.webp",
