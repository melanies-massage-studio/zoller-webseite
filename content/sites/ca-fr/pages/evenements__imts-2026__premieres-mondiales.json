     {
      "type": "textmedia",
      "header": "<h2> FAQ </h2>",
      "body": "<p class=\"large-text\">Foire aux questions</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
