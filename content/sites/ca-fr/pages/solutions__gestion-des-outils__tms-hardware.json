       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<p class=\"large-text\">Vous souhaitez gagner en productivité et en rentabilité grâce à un système de stockage d'outils efficace ? Alors les Smart Cabinets de ZOLLER sont exactement ce qu'il vous faut !</p> <p class=\"large-text\">Nous vous proposons la solution de stockage adaptée, que vous souhaitiez gérer des outils et leurs composants, des accessoires ou encore des équipements de mesure et de contrôle. Grâce à l'intégration logicielle, l'ensemble du stock peut être visualisé virtuellement.</p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "text",
      "id": "c163266",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ]
   ],
   "ftype": "container-2cols",
   "id": "c163314",
   "bg": "",
   "space": {
    "before": "none",
    "after": "default"
   }
  },
  {
   "type": "quotes",
   "header": "",
   "slides": [
    {
     "img": {
      "src": "/fileadmin/_processed_/1/e/csm_josua_schade_9179cf0129.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">Chez ZOLLER, nous adaptons le matériel et les logiciels aux besoins des utilisateurs. Nous proposons ainsi des solutions pratiques provenant d’un seul et même fournisseur.</p> <p><strong>Josua Schade, gestion des produits TMS-Hardware</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/a/b/csm_sarah-michelle_wiacek_c4c06a6999.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">L'équipe de montage ZOLLER de Pleidelsheim, en Allemagne, met chaque jour tout en œuvre pour garantir une qualité constante et élevée de vos Smart Cabinets. C'est tout simplement génial de faire partie de cette aventure !</p> <p><strong>Sarah-Michelle Wiacek, équipe de préparation du travail</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    },
    {
     "img": {
      "src": "/fileadmin/_processed_/0/9/csm_michael_haas_a5847acaff.webp",
      "alt": ""
     },
     "text": "<p class=\"extra-large-text\">Grâce aux Smart Cabinets, nos clients ZOLLER améliorent non seulement leur efficacité, mais évitent également les erreurs au cours du processus de fabrication.</p> <p><strong>Michael Haas, service commercial ZOLLER Sud</strong></p>",
     "right": true,
     "quote": true,
     "dark": true
    }
   ],
