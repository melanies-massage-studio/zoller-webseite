   "columns": [
    [
     {
      "type": "textmedia",
      "header": "<h2> Solutions intelligentes de stockage et de gestion </h2>",
      "body": "",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
