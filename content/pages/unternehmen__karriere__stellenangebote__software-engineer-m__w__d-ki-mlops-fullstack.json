    [
     {
      "type": "textmedia",
      "header": "<h3> Bereich Informatik </h3> <h1> Software Engineer (m/w/d) – KI, MLOps &amp; Fullstack </h1>",
      "body": "<p><a href=\"/fileadmin/01_Pages/Company/Career/DE/Software_Engineer_2026_09_03_ZOLLER.pdf\" rel=\"noopener\" target=\"_blank\">Stellenangebot zum Download (pdf)</a></p>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
      "valign": "top",
      "ftype": "textmedia",
      "id": "c231339",
      "bg": "",
      "space": {
       "before": "default",
       "after": "default"
      }
     }
    ],
    [
     {
      "type": "textmedia",
      "header": "",
      "body": "<h4>Ihr Profil</h4><ul><li>Studium der Informatik, Data Science, Künstlichen Intelligenz oder vergleichbare Qualifikation</li><li>Gute bis sehr gute Kenntnisse in Python</li><li>Erfahrung in der Softwareentwicklung und Interesse an KI-Anwendungen</li><li>Selbstständige und strukturierte Arbeitsweise sowie Freude an interdisziplinärer Zusammenarbeit</li><li>PyTorch oder TensorFlow, Docker/Kubernetes, Git/CI/CD, Linux, Computer Vision</li><li>moderne Webtechnologien, REST, relationale Datenbanken, FastAPI/.NET, dealerweise C#</li></ul> <h4>Ihre Aufgaben</h4> <p><strong>Schwerpunkt Machine Learning/MLOps</strong></p><ul><li>Entwicklung, Training und Optimierung von KI-Modellen</li><li>Aufbau und Automatisierung von MLOps-, CI/CD- und Deployment-Prozessen</li><li>Verwaltung und Versionierung von Daten und KI-Modellen</li><li>Performanceoptimierung und Benchmarking von KI-Hardware</li><li>Entwicklung innovativer Lösungen für industrielle Bild- und Messdaten</li></ul><p><strong>Schwerpunkt Fullstack/Backend</strong></p><ul><li>Entwicklung moderner Webanwendungen und Dashboards</li><li>Entwicklung von REST-APIs und Backend-Services</li><li>Umsetzung von Benutzer- und Rechteverwaltung sowie Datenmanagement</li><li>Integration von Bilddaten, KI-Modellen und Software-Services</li><li>Anbindung der Anwendungen an unsere ZOLLER-Messgeräte</li></ul>",
      "images": [],
      "videos": [],
      "pos": "text",
      "cols": 1,
