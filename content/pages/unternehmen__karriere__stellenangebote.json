   "body": "<h4>Informatik</h4><figure><table><tbody><tr><td><p><a class=\"link-arrow\" href=\"/unternehmen/karriere/stellenangebote/software-engineer-m/w/d-ki-mlops-fullstack\">Software Engineer (m/w/d) – KI, MLOps &amp; Fullstack</a></p></td></tr></tbody></table></figure> <h4>IT-Systeme</h4><figure><table><tbody><tr><td><p><a class=\"link-arrow\" href=\"/abas-erp-betreuer/-entwickler-m/w/d\">abas ERP-Betreuer/-Entwickler (m/w/d)</a></p></td></tr></tbody></table></figure><figure><table><tbody><tr><td><p><a class=\"link-arrow\" href=\"/it-administrator-m/w/d\">IT-Administrator (m/w/d) – IT-Infrastruktur &amp; Support</a></p></td></tr></tbody></table></figure><figure><table><tbody><tr><td><p><a class=\"link-arrow\" href=\"/unternehmen/karriere/stellenangebote/it-administrator-m/w/d\">IT-Administrator (m/w/d)</a></p></td></tr></tbody></table></figure> <h4>Elektrokonstruktion</h4><figure><table><tbody><tr><td><p><a class=\"link-arrow\" href=\"/sps-programmierer-m/w/d\">SPS-Programmierer (m/w/d)</a></p></td></tr></tbody></table></figure><figure><table><tbody><tr><td><p><a class=\"link-arrow\" href=\"/mechatroniker-m/w/d\">Mechatroniker (m/w/d)</a></p></td></tr></tbody></table></figure><figure><table><tbody><tr><td><p><a class=\"link-arrow\" href=\"/elektrokonstrukteur-m/w/d\">Elektrokonstrukteur (m/w/d)</a></p></td></tr></tbody></table></figure> <h4>Projekt Management Office &amp; Automation</h4><figure><table><tbody><tr><td><p><a class=\"link-arrow\" href=\"/unternehmen/karriere/stellenangebote/produktmanager-m/w/d\">Produktmanager (m/w/d)</a></p></td></tr></tbody></table></figure> <h4>Produktion</h4><figure><table><tbody><tr><td><p><a class=\"link-arrow\" href=\"/unternehmen/karriere/stellenangebote/monteur-mechanik/elektrik-m/w/d\">Monteur Mechanik/Elektrik (m/w/d)</a></p></td></tr></tbody></table></figure> <h4>Service</h4><figure><table><tbody><tr><td><p><a class=\"link-arrow\" href=\"/technische-mitarbeiter-service-innendienst-m/w/d\">Technische Mitarbeiter Service-Innendienst (m/w/d)</a></p></td></tr></tbody></table></figure> <h4>Qualitätsmanagement</h4><figure><table><tbody><tr><td><p><a class=\"link-arrow\" href=\"/unternehmen/karriere/stellenangebote/mitarbeiter-qualitaetssicherung/abnahme-m/w/d\">Mitarbeiter Qualitätssicherung/Abnahme (m/w/d)</a></p></td></tr></tbody></table></figure>",
