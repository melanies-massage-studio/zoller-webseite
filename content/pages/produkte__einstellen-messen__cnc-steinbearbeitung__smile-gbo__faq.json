        "title": "Why is tool presetting important in the stone industry?",
        "blocks": [
         {
          "type": "textmedia",
          "header": "",
          "body": "<p>Tool presetting in the stone industry reduces set-up time, increases cutting tool life, and improves cutting precision.</p>",
          "images": [],
          "videos": [],
          "pos": "text",
          "cols": 1,
          "valign": "top",
          "ftype": "text",
          "id": "c164752",
          "bg": "",
