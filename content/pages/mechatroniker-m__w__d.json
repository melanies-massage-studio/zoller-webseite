      "type": "textmedia",
      "header": "<h3> Elektrokonstruktion </h3> <h1> Mechatroniker (m/w/d) </h1>",
      "body": "<p><a href=\"/fileadmin/01_Pages/Company/Career/DE/Mechatroniker_2026_07_02_ZOLLER.pdf\" rel=\"noopener\" target=\"_blank\">Stellenangebot zum Download (pdf)</a></p>",
