  },
  {
   "type": "textmedia",
   "header": "<h2> First ZOLLER Toolroom of the Year winner announced </h2>",
   "body": "<p>ZOLLER Inc. was proud to announce the winners of its first-ever Toolroom of the Year competition during IMTS 2024 in Chicago. Atlas Fibre, a premier manufacturer of thermoset composite materials, took home the first-place trophy for the impressive array of technology at its 120,000-square-foot facility in Northbrook, Illinois.</p>",
   "images": [],
   "videos": [
    {
     "kind": "iframe",
     "src": "https://www.youtube-nocookie.com/embed/GsjAckdpQJ0?autohide=1&controls=1&enablejsapi=1&origin=https%3A%2F%2Fwww.zoller.info",
     "title": "First ZOLLER Toolroom of the Year winner announced at IMTS 2024"
    }
   ],
   "pos": "right",
   "cols": 1,
   "valign": "center",
   "ftype": "textmedia",
